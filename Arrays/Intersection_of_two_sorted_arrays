1. Problem Statement
Given two sorted arrays, return their intersection.

Example:
  Input:
  arr1 = [1,2,2,3,4]
  arr2 = [2,2,4,6]

  Output:
  [2,2,4]


Brute Force Approach:
Algorithm
  Create a visited array initialized to false.
  Traverse every element of arr1.
  For every element of arr1, traverse arr2.

  If:
  Elements are equal, and
  That element in arr2 has not been used,

  then:
  Add it to the answer.
  Mark it as visited.
  Break the inner loop.

Code:
#include <iostream>
#include <vector>
using namespace std;

vector<int> intersection(vector<int>& arr1, vector<int>& arr2)
{
    vector<int> ans;
    vector<bool> visited(arr2.size(), false);

    for(int i = 0; i < arr1.size(); i++)
    {
        for(int j = 0; j < arr2.size(); j++)
        {
            if(arr1[i] == arr2[j] && !visited[j])
            {
                ans.push_back(arr1[i]);
                visited[j] = true;
                break;
            }
        }
    }

    return ans;
}

int main()
{
    vector<int> arr1 = {1,2,2,3,4};
    vector<int> arr2 = {2,2,4,6};

    vector<int> ans = intersection(arr1, arr2);

    for(int x : ans)
        cout << x << " ";
}
Time Complexity: O(n × m)
Space Complexity: O(m)

The brute force approach does not use the fact that both arrays are already sorted.
Even though the arrays are sorted, it still compares every element of the first array with almost every element of the second array.
For large arrays, this becomes very slow (O(n × m)).
Since the arrays are sorted, we can avoid unnecessary comparisons by using the Two Pointer Technique, reducing the time complexity to O(n + m).


Optimal Solution: Two Pointer Approach
Since both arrays are sorted:
  Start one pointer at the beginning of each array.
  Compare the elements.

Three cases arise:
Case 1:
If
  arr1[i] == arr2[j]
  It belongs to the intersection.
  Store it and move both pointers.

Case 2:
If
  arr1[i] < arr2[j]
  Since arr1 is sorted, this smaller element can never match any later element in arr2.
  Move pointer i.

Case 3:
If
  arr1[i] > arr2[j]
  Similarly, move pointer j.

Code:
#include <iostream>
#include <vector>
using namespace std;

vector<int> intersection(vector<int>& arr1, vector<int>& arr2)
{
    vector<int> ans;

    int i = 0;
    int j = 0;

    while(i < arr1.size() && j < arr2.size())
    {
        if(arr1[i] == arr2[j])
        {
            ans.push_back(arr1[i]);
            i++;
            j++;
        }
        else if(arr1[i] < arr2[j])
        {
            i++;
        }
        else
        {
            j++;
        }
    }

    return ans;
}

int main()
{
    vector<int> arr1 = {1,2,2,3,4};
    vector<int> arr2 = {2,2,4,6};

    vector<int> ans = intersection(arr1, arr2);

    for(int x : ans)
        cout << x << " ";
}

Time Complexity: O(n + m)

Space Complexity:
No extra data structure is used apart from the output array.
Auxiliary Space: O(1)
