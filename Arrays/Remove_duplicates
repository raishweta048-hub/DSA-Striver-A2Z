Problem:
Given a sorted array, remove duplicates in-place and return the number of unique elements.


Approach (Two Pointer):
Since the array is already sorted:
Duplicate elements will always be adjacent.
Keep one pointer i for the position of the last unique element.
Traverse the array using another pointer j.
Whenever a new unique element is found:
Increment i
Place the unique element at arr[i]


Code:
#include <iostream>
#include <vector>
using namespace std;

int removeDuplicates(vector<int>& nums) {
    int n = nums.size();

    if (n == 0)
        return 0;

    int i = 0;

    for (int j = 1; j < n; j++) {
        if (nums[j] != nums[i]) {
            i++;
            nums[i] = nums[j];
        }
    }

    return i + 1;
}

int main() {
    vector<int> nums = {1,1,2,2,3,4,4,5};

    int k = removeDuplicates(nums);

    cout << "Number of unique elements: " << k << endl;

    cout << "Array after removing duplicates: ";

    for (int i = 0; i < k; i++) {
        cout << nums[i] << " ";
    }

    return 0;
}


Time Complexity  : O(n)
Space Complexity : O(1)
