Approach:
Assume the first element is the largest.

Traverse the entire array.

Compare each element with the current largest.

If a larger element is found, update the largest value.

After completing the traversal, return the largest element.


Time and Space complexity:
Time Complexity: O(n) 
Space Complexity: O(1)


Code:
#include <iostream>
#include <vector>

using namespace std;

class Solution {
public:
    int largestElement(vector<int>& nums) {
        int n = nums.size();
        int largest = nums[0];

        for (int i = 0; i < n; i++) {
            if (nums[i] > largest) {
                largest = nums[i];
            }
        }

        return largest;
    }
};

int main() {
    int n;

    cout << "Enter the number of elements: ";
    cin >> n;

    vector<int> nums(n);

    cout << "Enter the elements: ";
    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }

    Solution obj;

    cout << "Largest Element: " << obj.largestElement(nums);

    return 0;
}
