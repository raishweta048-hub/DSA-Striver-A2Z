Problem Statement:
Given a binary array containing only 0 and 1, find the maximum number of consecutive 1s present in the array.

Example:
Input:  [1, 1, 0, 1, 1, 1, 0, 1]
Output: 3

Optimal Approach:
Traverse the array from left to right.
If the current element is 1, increment count.
If the current element is 0, reset count to 0.
After every element, update maxCount.
Return maxCount

Code:
#include <iostream>
using namespace std;

int findMaxConsecutiveOnes(int arr[], int n) {
    int count = 0;
    int maxCount = 0;

    for (int i = 0; i < n; i++) {
        if (arr[i] == 1) {
            count++;
            maxCount = max(maxCount, count);
        } 
        else {
            count = 0;
        }
    }

    return maxCount;
}

int main() {
    int arr[] = {1, 1, 0, 1, 1, 1, 0, 1};
    int n = sizeof(arr) / sizeof(arr[0]);

    cout << "Maximum consecutive ones: "
         << findMaxConsecutiveOnes(arr, n);

    return 0;
}

Time Complexity: O(n) 
Space Complexity: O(1)
